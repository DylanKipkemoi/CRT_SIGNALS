# Copy to .env and fill in. Never commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Include your public HTTPS tunnel/domain when testing callbacks, e.g. https://abcd.ngrok-free.app
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000
SITE_NAME=CRT Signals
CONTACT_EMAIL=support@example.com

# Email (console backend prints emails to the terminal during development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=CRT Signals <no-reply@example.com>

# Optional: Redis cache for multi-process rate limiting / locks
# REDIS_URL=redis://127.0.0.1:6379/1

# --- Market data ---
# BTCUSD uses public Coinbase Exchange / Kraken endpoints (no key required).
# XAUUSD needs ONE of the following providers:
TWELVEDATA_API_KEY=
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# --- Scanner ---
SCANNER_INTERVAL_SECONDS=300

# --- M-Pesa Daraja (STK Push / M-Pesa Express) ---
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
# Only for Buy Goods (till) setups where PartyB differs from BusinessShortCode
DARAJA_PARTY_B=
# Public HTTPS base URL that Safaricom can reach, e.g. https://abcd.ngrok-free.app
DARAJA_CALLBACK_BASE_URL=
# Long random string; becomes part of the callback path
DARAJA_CALLBACK_TOKEN=
# Optional comma-separated allowlist of Safaricom callback source IPs
DARAJA_ALLOWED_CALLBACK_IPS=
DARAJA_VERIFY_WITH_QUERY=true
DARAJA_ACCOUNT_REFERENCE=CRTSIGNALS
